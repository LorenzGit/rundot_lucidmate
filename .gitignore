# Test and QA output. `screenshots/` is anchored to the repo root on purpose:
# unanchored it also swallows docs/screenshots, which the README links to, and
# the images turn into broken links on GitHub without anything failing locally.
coverage/
playwright-report/
test-results/
/screenshots/
tmp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

