{
  "recipes": {
    "lucidmate_send_challenge_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "beginEffects": [
        {
          "type": "send_inbox_message",
          "recipientProfileId": "{{inputs.targetId}}",
          "template": "lucidmate_challenge",
          "params": {},
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          },
          "as": "delivery"
        }
      ]
    },
    "lucidmate_send_move_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "beginEffects": [
        {
          "type": "send_inbox_message",
          "recipientProfileId": "{{inputs.targetId}}",
          "template": "lucidmate_your_move",
          "params": { "opponent": "{{inputs.opponent}}" },
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          },
          "roomNotification": {
            "sourceType": "room_turn",
            "roomId": "{{inputs.roomId}}",
            "notificationKey": "{{inputs.eventKey}}"
          },
          "as": "delivery"
        }
      ]
    },
    "lucidmate_send_reaction_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "beginEffects": [
        {
          "type": "send_inbox_message",
          "recipientProfileId": "{{inputs.targetId}}",
          "template": "lucidmate_reaction",
          "params": {
            "opponent": "{{inputs.opponent}}",
            "reaction": "{{inputs.reaction}}"
          },
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          },
          "as": "delivery"
        }
      ]
    },
    "lucidmate_send_rematch_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "beginEffects": [
        {
          "type": "send_inbox_message",
          "recipientProfileId": "{{inputs.targetId}}",
          "template": "lucidmate_rematch",
          "params": { "opponent": "{{inputs.opponent}}" },
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          },
          "as": "delivery"
        }
      ]
    }
  }
}
