{
  "recipes": {
    "lucidmate_send_challenge_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "inputs": {
        "targetId": { "type": "string" },
        "matchKey": { "type": "string" },
        "pace": { "type": "string" },
        "eventKey": { "type": "string" }
      },
      "beginEffects": [
        {
          "type": "send_inbox_message",
          "recipientProfileId": "{{inputs.targetId}}",
          "template": "lucidmate_challenge",
          "params": {},
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          },
          "roomNotification": {
            "sourceType": "realtime_room",
            "roomId": "{{inputs.matchKey}}",
            "notificationKey": "{{inputs.eventKey}}"
          },
          "as": "delivery"
        }
      ]
    },
