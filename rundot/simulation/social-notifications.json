{
  "recipes": {
    "lucidmate_send_challenge_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "inputs": {
        "targetId": { "type": "string" },
        "matchKey": { "type": "string" },
        "pace": { "type": "string" }
      },
      "beginEffects": [
        {
          "type": "send_notification",
          "recipientProfileId": "{{inputs.targetId}}",
          "title": "A LUCIDMATE challenge is waiting",
          "body": "You play White and make the first move.",
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          }
        }
      ]
    },
    "lucidmate_send_move_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "inputs": {
        "targetId": { "type": "string" },
        "opponent": { "type": "string" },
        "matchKey": { "type": "string" },
        "pace": { "type": "string" }
      },
      "beginEffects": [
        {
          "type": "send_notification",
          "recipientProfileId": "{{inputs.targetId}}",
          "title": "Your move in LUCIDMATE",
          "body": "{{inputs.opponent}} moved. Your board is waiting.",
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          }
        }
      ]
    },
    "lucidmate_send_reaction_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "inputs": {
        "targetId": { "type": "string" },
        "opponent": { "type": "string" },
        "reaction": { "type": "string" },
        "matchKey": { "type": "string" },
        "pace": { "type": "string" }
      },
      "beginEffects": [
        {
          "type": "send_notification",
          "recipientProfileId": "{{inputs.targetId}}",
          "title": "A rival reacted",
          "body": "{{inputs.opponent}}: {{inputs.reaction}}",
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          }
        }
      ]
    },
    "lucidmate_send_rematch_notification": {
      "duration": 0,
      "scope": "player",
      "clientViewable": false,
      "inputs": {
        "targetId": { "type": "string" },
        "opponent": { "type": "string" },
        "matchKey": { "type": "string" },
        "pace": { "type": "string" }
      },
      "beginEffects": [
        {
          "type": "send_notification",
          "recipientProfileId": "{{inputs.targetId}}",
          "title": "Rematch?",
          "body": "{{inputs.opponent}} wants another game.",
          "payload": {
            "route": "match",
            "matchKey": "{{inputs.matchKey}}",
            "pace": "{{inputs.pace}}"
          }
        }
      ]
    }
  }
}
